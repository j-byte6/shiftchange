# Postgres connection string. On Vercel this is filled in when you add a Neon database.
DATABASE_URL=postgres://user:password@host/dbname

# A secret phrase you choose. Needed once, to create the first manager account at /setup.
SETUP_CODE=change-me

# The site's public address, used in invite and password reset links.
APP_URL=http://localhost:3000

# Optional: send emails through Resend (https://resend.com). Without these, the app
# shows invite and reset links on screen for a manager to copy and send.
RESEND_API_KEY=
EMAIL_FROM="ShiftChange <shifts@example.com>"
